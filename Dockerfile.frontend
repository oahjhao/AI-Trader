# Frontend Dockerfile for AI-Trader Web UI
# Builds a lightweight Nginx image serving the static docs.
# Dynamic trading data is expected to be mounted at /usr/share/nginx/html/data via EFS.
# Pure frontend container - no trader scheduling functionality.

FROM nginx:stable-alpine

# Install minimal required tools
RUN apk add --no-cache \
    curl \
    tzdata

# Set timezone to Asia/Shanghai
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Copy custom Nginx config
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Note: Static files are no longer pre-packaged
# Frontend expects docs to be mounted from EFS at /usr/share/nginx/html/
# This keeps the frontend container pure and stateless

EXPOSE 80

# Use default nginx entrypoint/cmd for pure static file serving
