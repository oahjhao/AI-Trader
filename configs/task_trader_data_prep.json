{
    "family": "trader-data-prep",
    "taskRoleArn": "arn:aws:iam::648104168728:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::648104168728:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "1024",
    "memory": "2048",
    "containerDefinitions": [
        {
            "name": "trader-data-prep",
            "image": "648104168728.dkr.ecr.us-west-2.amazonaws.com/shanavasa/trader-app:latest",
            "essential": true,
            "entryPoint": ["bash", "scripts/data_preparation_entrypoint.sh"],
            "environment": [
                {"name": "CONFIG_FILE", "value": ""},
                {"name": "DATE_SUFFIX", "value": ""},
                {"name": "START_DATE", "value": ""},
                {"name": "END_DATE", "value": ""},
                {"name": "OPENAI_API_BASE", "value": "https://api.deepseek.com/v1"},
                {"name": "OPENAI_API_KEY", "value": "sk-f89095e5baa945899b997e955014d64b"},
                {"name": "ALPHAADVANTAGE_API_KEY", "value": "RRO2EJROZ0DNP0Y2"},
                {"name": "JINA_API_KEY", "value": "jina_6bab6d0cb8b14cb7885ebb4e8c51373eKu5hw-kbM-dGIFZThZEFxnRJSxpn"},
                {"name": "TUSHARE_TOKEN", "value": "822130fe12b4a3f37b23c6718477718ac08450f703e76156bb241a6c"},
                {"name": "MATH_HTTP_PORT", "value": "8000"},
                {"name": "SEARCH_HTTP_PORT", "value": "8001"},
                {"name": "TRADE_HTTP_PORT", "value": "8002"},
                {"name": "GETPRICE_HTTP_PORT", "value": "8003"},
                {"name": "AGENT_MAX_STEP", "value": "30"},
                {"name": "RUNTIME_ENV_PATH", "value": "/home/ec2-user/AI-Trader/.runtime_env.json"},
                {"name": "AWS_REGION", "value": "us-west-2"},
                {"name": "ECS_CLUSTER", "value": "trader-cluster"},
                {"name": "ECS_SUBNET", "value": "subnet-0307b527137ee17d9"},
                {"name": "ECS_SECURITY_GROUP", "value": "sg-0e9ea03fd1beaaad9"},
                {"name": "DATA_PREP_TASK_DEF", "value": "trader-data-prep"},
                {"name": "AGENT_TASK_DEF", "value": "trader-agent"},
                {"name": "DINGTALK_WEBHOOK_URL", "value": "https://oapi.dingtalk.com/robot/send?access_token=0e2effcc1d395b7c7720101fd66dc6296ff51cc0aaea952661f2a5f8164938c8"},
                {"name": "DINGTALK_SECRET", "value": "YOUR_SECRET_KEY"},
                {"name": "NLTK_DATA", "value": "/home/ec2-user/nltk_data"},
                {"name": "REPORT_SCHEDULE_TIME", "value": "11:30"},
                {"name": "TZ", "value": "Asia/Shanghai"}
            ],
            "mountPoints": [
                {"sourceVolume": "efs-configs", "containerPath": "/home/ec2-user/AI-Trader/configs"},
                {"sourceVolume": "efs-data", "containerPath": "/home/ec2-user/AI-Trader/data"},
                {"sourceVolume": "efs-logs", "containerPath": "/home/ec2-user/AI-Trader/logs"},
                {"sourceVolume": "efs-docs", "containerPath": "/home/ec2-user/AI-Trader/docs"}
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/trader-data-prep",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-west-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "volumes": [
        {
            "name": "efs-configs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/configs",
                "transitEncryption": "ENABLED"
            }
        },
        {
            "name": "efs-data",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/data",
                "transitEncryption": "ENABLED"
            }
        },
        {
            "name": "efs-logs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/logs",
                "transitEncryption": "ENABLED"
            }
        },
        {
            "name": "efs-docs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/docs",
                "transitEncryption": "ENABLED"
            }
        }
    ]
}
