{
    "family": "trader-data-prep",
    "taskRoleArn": "arn:aws:iam::648104168728:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::648104168728:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "1024",
    "memory": "2048",
    "containerDefinitions": [
        {
            "name": "trader-data-prep",
            "image": "648104168728.dkr.ecr.us-west-2.amazonaws.com/shanavasa/trader-app:latest",
            "essential": true,
            "entryPoint": ["bash", "scripts/data_preparation_entrypoint.sh"],
            "environment": [
                {"name": "CONFIG_FILE", "value": ""},
                {"name": "DATE_SUFFIX", "value": ""},
                {"name": "START_DATE", "value": ""},
                {"name": "END_DATE", "value": ""},
                {"name": "TZ", "value": "Asia/Shanghai"}
            ],
            "mountPoints": [
                {"sourceVolume": "efs-configs", "containerPath": "/home/ec2-user/AI-Trader/configs"},
                {"sourceVolume": "efs-data", "containerPath": "/home/ec2-user/AI-Trader/data"},
                {"sourceVolume": "efs-logs", "containerPath": "/home/ec2-user/AI-Trader/logs"},
                {"sourceVolume": "efs-docs", "containerPath": "/home/ec2-user/AI-Trader/docs"}
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/trader-data-prep",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-west-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "volumes": [
        {
            "name": "efs-configs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/configs",
                "transitEncryption": "ENABLED"
            }
        },
        {
            "name": "efs-data",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/data",
                "transitEncryption": "ENABLED"
            }
        },
        {
            "name": "efs-logs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/logs",
                "transitEncryption": "ENABLED"
            }
        },
        {
            "name": "efs-docs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/docs",
                "transitEncryption": "ENABLED"
            }
        }
    ]
}
