{
    "family": "trader-frontend",
    "containerDefinitions": [
        {
            "name": "trader-frontend",
            "image": "648104168728.dkr.ecr.us-west-2.amazonaws.com/shanavasa/trader-frontend:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "trader-frontend-8888-tcp",
                    "containerPort": 8888,
                    "hostPort": 8888,
                    "protocol": "tcp",
                    "appProtocol": "http"
                },
                {
                    "name": "trader-frontend-80-tcp",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "environmentFiles": [],
            "mountPoints": [
                {
                    "sourceVolume": "efs-docs",
                    "containerPath": "/usr/share/nginx/html",
                    "readOnly": true
                },
                {
                    "sourceVolume": "efs-data",
                    "containerPath": "/usr/share/nginx/html/data",
                    "readOnly": true
                },
                {
                    "sourceVolume": "efs-configs",
                    "containerPath": "/mnt/efs/configs",
                    "readOnly": true
                },
                {
                    "sourceVolume": "efs-logs",
                    "containerPath": "/mnt/efs/logs",
                    "readOnly": true
                }
            ],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/trader-frontend",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-west-2",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ],
    "taskRoleArn": "arn:aws:iam::648104168728:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::648104168728:role/ecsTaskExecutionRole",
    "networkMode": "bridge",
    "volumes": [
        {
            "name": "efs-docs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/docs"
            }
        },
        {
            "name": "efs-data",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/data"
            }
        },
        {
            "name": "efs-configs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/configs"
            }
        },
        {
            "name": "efs-logs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/logs"
            }
        }
    ],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "EC2"
    ],
    "cpu": "2048",
    "memory": "1536",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "enableFaultInjection": false
}