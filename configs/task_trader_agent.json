{
    "family": "trader-agent",
    "taskRoleArn": "arn:aws:iam::648104168728:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::648104168728:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "1024",
    "memory": "2048",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "containerDefinitions": [
        {
            "name": "trader-agent",
            "image": "648104168728.dkr.ecr.us-west-2.amazonaws.com/shanavasa/trader-app:latest",
            "essential": true,
            "entryPoint": ["bash", "scripts/container_entrypoint.sh"],
            "environment": [
                {"name": "DATE_SUFFIX", "value": ""},
                {"name": "DINGTALK_WEBHOOK_URL", "value": ""},
                {"name": "DINGTALK_SECRET", "value": ""},
                {"name": "OPENAI_API_BASE", "value": ""},
                {"name": "OPENAI_API_KEY", "value": ""},
                {"name": "RUNTIME_ENV_PATH", "value": "/home/ec2-user/AI-Trader/data/runtime_env.json"},
                {"name": "TZ", "value": "Asia/Shanghai"}
            ],
            "mountPoints": [
                {"sourceVolume": "efs-configs", "containerPath": "/home/ec2-user/AI-Trader/configs", "readOnly": false},
                {"sourceVolume": "efs-data", "containerPath": "/home/ec2-user/AI-Trader/data", "readOnly": false},
                {"sourceVolume": "efs-logs", "containerPath": "/home/ec2-user/AI-Trader/logs", "readOnly": false},
                {"sourceVolume": "efs-docs", "containerPath": "/home/ec2-user/AI-Trader/docs", "readOnly": false}
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/trader-agent",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-west-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "volumes": [
        {
            "name": "efs-configs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/configs"
            }
        },
        {
            "name": "efs-data",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/data"
            }
        },
        {
            "name": "efs-logs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/logs"
            }
        },
        {
            "name": "efs-docs",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0b84c5c74e468c34b",
                "rootDirectory": "/ai-trader/docs"
            }
        }
    ]
}
